{
  "name": "biochemical-inference",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "BIOCHEMICAL_INFERENCE_PUBLIC_ORIGIN=http://127.0.0.1:5173 node --watch server/index.js",
    "dev:web": "vite",
    "build": "vite build && npm run build:server",
    "build:server": "node server/build.js",
    "build:static": "VITE_STATIC_MODE=true vite build --outDir dist-static",
    "start": "node server-dist/server/index.js",
    "ops": "node scripts/operations.js",
    "ops:bootstrap": "node scripts/operations.js bootstrap",
    "ops:init": "node scripts/operations.js init",
    "ops:start": "node scripts/operations.js start",
    "ops:smoke": "node scripts/operations.js smoke",
    "ops:backup": "node scripts/operations.js backup",
    "ops:verify-backup": "node scripts/operations.js verify-backup",
    "ops:restore": "node scripts/operations.js restore",
    "ops:dr-test": "node scripts/operations.js dr-test",
    "supply-chain:generate": "node scripts/supply-chain.js generate",
    "supply-chain:verify": "node scripts/supply-chain.js verify",
    "check:syntax": "node tests/check-syntax.js",
    "kb:validate": "node scripts/kb-validate.js",
    "check": "npm run check:syntax && npm run test:selection && npm test && npm run build",
    "test": "npm run test:routine",
    "test:routine": "nice -n 10 vitest run --maxWorkers=1 --no-file-parallelism --exclude='tests/e2e/**' --exclude='tests/acceptance/**' --exclude='tests/revalidation/scale-acceptance.test.js' --exclude='tests/revalidation/planning-performance.test.js' --exclude='tests/revalidation/cross-repo-scale-http.test.js'",
    "test:ops": "nice -n 10 vitest run tests/unit/operations.test.js tests/api/operations-api.test.js --maxWorkers=1 --no-file-parallelism",
    "test:ops:acceptance": "npm run test:acceptance:operations",
    "test:acceptance": "npm run test:acceptance:node && npm run test:acceptance:e2e",
    "test:acceptance:node": "nice -n 10 vitest run tests/acceptance/operations-process.test.js tests/acceptance/operations-supervisor.test.js tests/acceptance/revalidation-process.test.js tests/revalidation/planning-performance.test.js tests/revalidation/scale-acceptance.test.js tests/revalidation/cross-repo-scale-http.test.js --maxWorkers=1 --no-file-parallelism",
    "test:certification:producer": "nice -n 10 vitest run tests/e2e/entity-mention-handoff-producer.test.js --maxWorkers=1 --no-file-parallelism",
    "test:acceptance:revalidation": "nice -n 10 vitest run tests/acceptance/revalidation-process.test.js tests/revalidation/planning-performance.test.js tests/revalidation/scale-acceptance.test.js tests/revalidation/cross-repo-scale-http.test.js --maxWorkers=1 --no-file-parallelism",
    "test:acceptance:operations": "nice -n 10 vitest run tests/acceptance/operations-process.test.js tests/acceptance/operations-supervisor.test.js --maxWorkers=1 --no-file-parallelism",
    "test:acceptance:e2e": "nice -n 10 playwright test --workers=1",
    "test:acceptance:e2e:built": "E2E_SKIP_BUILD=true nice -n 10 playwright test --workers=1",
    "test:selection": "nice -n 10 node scripts/test-selection.js",
    "test:watch": "nice -n 10 vitest --maxWorkers=1 --no-file-parallelism --exclude='tests/e2e/**' --exclude='tests/acceptance/**' --exclude='tests/revalidation/scale-acceptance.test.js' --exclude='tests/revalidation/planning-performance.test.js' --exclude='tests/revalidation/cross-repo-scale-http.test.js'",
    "test:e2e": "npm run test:acceptance:e2e --"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/static": "^10.1.0",
    "fast-xml-parser": "^5.10.0",
    "fastify": "^5.2.1",
    "three": "^0.173.0",
    "vue": "3.6.0-rc.11",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.51.0",
    "@testing-library/vue": "^8.1.0",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "^2.4.6",
    "concurrently": "^9.1.2",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.30",
    "pug": "^3.0.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.6"
  },
  "overrides": {
    "vue": "$vue"
  }
}
