{
  "name": "biochemical-inference",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch server/index.js",
    "dev:web": "vite",
    "build": "vite build && npm run build:server",
    "build:server": "node server/build.js",
    "start": "node server-dist/server/index.js",
    "check:syntax": "node tests/check-syntax.js",
    "check": "npm run check:syntax && npm test && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/static": "^10.1.0",
    "fastify": "^5.2.1",
    "three": "^0.173.0",
    "vue": "^3.5.13",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@testing-library/vue": "^8.1.0",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vue/test-utils": "^2.4.6",
    "concurrently": "^9.1.2",
    "jsdom": "^26.0.0",
    "pug": "^3.0.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.6"
  }
}
